{
  "name": "webmanab",
  "version": "2.0.0",
  "description": "webmanab.html",
  "author": "uto-usui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "predev": "node scripts/build-og.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-og.mjs",
    "build": "astro build --force",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.{astro,css,scss}\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{astro,css,scss}\" --allow-empty-input --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:dist": "vitest run --project dist",
    "test:e2e": "playwright test --project=smoke",
    "test:a11y": "playwright test --project=a11y && node scripts/a11y-compare.ts",
    "test:visual": "playwright test --project=visual",
    "catalog": "CATALOG=1 astro dev",
    "build:catalog": "CATALOG=1 astro build --outDir dist-catalog",
    "test:catalog": "playwright test -c playwright.catalog.config.ts",
    "a11y:compare": "node scripts/a11y-compare.ts",
    "check:links": "node scripts/check-links.ts",
    "export:md": "node scripts/export-markdown/export.ts",
    "verify:md": "node scripts/export-markdown/verify.ts",
    "sync:vault": "node scripts/sync-vault/sync.ts",
    "build:glyphs": "node scripts/eyecatch/build-glyphs.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm test:dist && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/rss": "4.0.19",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.4.2",
    "hljs10": "npm:highlight.js@10.1.1",
    "image-size": "2.0.4",
    "linkedom": "0.18.14",
    "sass": "1.106.1",
    "satteri": "0.11.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/internal-helpers": "0.13.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@fontsource/open-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.5",
    "entities": "8.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "hast-util-to-html": "9.0.5",
    "hast-util-to-mdast": "10.1.2",
    "hast-util-to-text": "4.0.3",
    "html-validate": "11.17.0",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "opentype.js": "2.0.0",
    "pagefind": "1.5.2",
    "postcss-html": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-stringify": "11.0.0",
    "satteri": "0.10.5",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.9.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "^8.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
