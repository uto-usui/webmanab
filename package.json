{
  "name": "webmanab",
  "version": "2.0.0",
  "description": "webmanab.html",
  "author": "uto-usui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && stylelint \"src/**/*.{astro,css,scss}\" --allow-empty-input",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{astro,css,scss}\" --allow-empty-input --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:dist": "vitest run --project dist",
    "test:e2e": "playwright test --project=smoke",
    "test:a11y": "playwright test --project=a11y && node scripts/a11y-compare.ts",
    "test:visual": "playwright test --project=visual",
    "catalog": "CATALOG=1 astro dev",
    "build:catalog": "CATALOG=1 astro build --outDir dist-catalog",
    "test:catalog": "playwright test -c playwright.catalog.config.ts",
    "a11y:compare": "node scripts/a11y-compare.ts",
    "check:links": "node scripts/check-links.ts",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm test:dist && pnpm test:e2e"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "sass": "1.105.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "html-validate": "11.16.2",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
