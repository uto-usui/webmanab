---
interface Props {
  text: string
  // ターム一覧の「tips」などは /tips/ のページがないので、呼び手がリンク先を決める
  href?: string
}

const { text, href = `/${text}/` } = Astro.props
---

<h2 class="h1">
  <span class="h1__inner">
    <a href={href}>{text}</a>
  </span>
</h2>

<style lang="scss">
  .h1 {
    font-style: italic;
    font-weight: bold;
    text-transform: capitalize;

    @include sizes(7);
  }

  .h1__inner {
    position: relative;
    padding-bottom: 10px;

    &::after {
      position: absolute;
      top: 0;
      left: -40px;
      width: 50px;
      height: 50px;
      content: '';
      border-top: 2px solid currentcolor;
      border-left: 2px solid currentcolor;
      transition: 0.45s $easeTitle;
    }

    &::before {
      position: absolute;
      right: -40px;
      bottom: 0;
      width: 50px;
      height: 50px;
      content: '';
      border-right: 2px solid currentcolor;
      border-bottom: 2px solid currentcolor;
      transition: 0.45s $easeTitle;
    }

    &:hover {
      &::after {
        left: 0;
        width: 100%;
        height: 2px;
      }

      &::before {
        right: 0;
        width: 100%;
        height: 2px;
      }
    }

    > a {
      position: relative;
      display: inline-block;
      font-weight: bold;
      color: $black;
      perspective: 400px;
      backface-visibility: hidden;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      transition:
        text-shadow 0.4s,
        letter-spacing 0.4s;

      &::after {
        position: absolute;
        top: -2.8em;
        left: 50%;
        width: 6em;
        font-size: $font-size-l2;
        font-style: italic;
        content: 'All View';
        opacity: 0;
        transform: translateX(-50%) rotateX(180deg) scale(0.6);
        transition: 0.45s $easeInQuart;
      }

      &:hover {
        letter-spacing: -0.05em;
        text-decoration: none;
        text-shadow:
          150px 3px 0 $thirdry-color,
          -150px 3px 0 $secondary-color;

        &::after {
          letter-spacing: 0.05em;
          opacity: 1;
          transform: translateX(-50%) rotateX(0) scale(1);
        }
      }
    }
  }
</style>
