---
import { PUBLIC_ADSENSE_CLIENT } from 'astro:env/client'

// 旧サイトと同じく a と img の間に空白を入れない（テンプレートに書くと整形で空白が入り、画像の位置がずれる）
const amazon = [
  '<a href="https://www.amazon.co.jp/dp/4767817358/ref=as_li_ss_il?_encoding=UTF8&colid=37QKPZ7VSHBB8&coliid=I1TH4VXMY4FORU&linkCode=li3&tag=utousui-22&linkId=e34c02744d84af010d64794df21dd7a3" target="_blank" rel="noopener">',
  '<img src="//ws-fe.amazon-adsystem.com/widgets/q?_encoding=UTF8&ASIN=4767817358&Format=_SL250_&ID=AsinImage&MarketPlace=JP&ServiceVersion=20070822&WS=1&tag=utousui-22" alt="世界で一番美しい猫の図鑑">',
  '</a>',
  '<img src="https://ir-jp.amazon-adsystem.com/e/ir?t=utousui-22&l=li3&o=9&a=4767817358" width="1" height="1" alt="">',
].join('')
---

<ul class="Ads-list">
  <li class="Ads-list_item">
    {PUBLIC_ADSENSE_CLIENT && (
      <>
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={PUBLIC_ADSENSE_CLIENT}
          data-ad-slot="1102437429"
          data-ad-format="auto"
        />
        <script is:inline>
          ;(window.adsbygoogle = window.adsbygoogle || []).push({})
        </script>
      </>
    )}
  </li>
  <li class="Ads-list_item" set:html={amazon} />
</ul>

<style lang="scss">
  // 旧サイトの class 名のまま（旧サイトとの比較のキーに使う）
  /* stylelint-disable selector-class-pattern */
  .Ads-list {
    display: flex;
    justify-content: space-around;
    margin-top: 4rem;

    @include tablet {
      margin-top: 6rem;
    }
  }

  .Ads-list_item {
    width: 100%;
    min-width: 330px;
    padding: 0.8rem;
    border: 6px double $black;

    // 狭い幅では書籍の枠を隠す（DOM の 2 つ目であることに依存）
    @include mobile {
      &:last-child {
        display: none;
      }
    }

    @include tablet {
      width: 40%;
    }
  }
  /* stylelint-enable selector-class-pattern */
</style>
