---
// 本文は Markdown から描画され scoped の属性が付かないので、本文と hljs の CSS は global にする
---

<div class="entry-content">
  <slot name="toc" />
  <div class="entry-content__inner">
    <slot />
  </div>
</div>

<style lang="scss" is:global>
  .entry-content {
    margin-bottom: $space-4;

    @include tablet {
      margin-bottom: $space-6;
    }
  }

  // 配色は旧サイトのまま（02 の 7.3）。.hljs-bullet は後に来る #d36363 が効く
  .hljs {
    display: block;
    padding: 0.5em;
    overflow-x: auto;
    color: #fff;
    background: #333;
  }

  .hljs-name,
  .hljs-strong {
    font-weight: bold;
  }

  .hljs-code,
  .hljs-emphasis {
    font-style: italic;
  }

  .hljs-tag {
    color: #62c8f3;
  }

  .hljs-variable,
  .hljs-template-variable,
  .hljs-selector-id,
  .hljs-selector-class {
    color: #ade5fc;
  }

  .hljs-string,
  .hljs-bullet {
    color: #a2fca2;
  }

  // hljs-built_in は highlight.js が付ける class 名
  /* stylelint-disable selector-class-pattern */
  .hljs-type,
  .hljs-title,
  .hljs-section,
  .hljs-attribute,
  .hljs-quote,
  .hljs-built_in,
  .hljs-builtin-name {
    color: #ffa;
  }
  /* stylelint-enable selector-class-pattern */

  .hljs-number,
  .hljs-symbol,
  .hljs-bullet {
    color: #d36363;
  }

  .hljs-keyword,
  .hljs-selector-tag,
  .hljs-literal {
    color: #fcc28c;
  }

  .hljs-comment,
  .hljs-deletion,
  .hljs-code {
    color: #888;
  }

  .hljs-regexp,
  .hljs-link {
    color: #c6b4f0;
  }

  .hljs-meta {
    color: #fc9b9b;
  }

  .hljs-deletion {
    color: #333;
    background-color: #fc9b9b;
  }

  .hljs-addition {
    color: #333;
    background-color: #a2fca2;
  }

  @mixin inline-code {
    padding: 2px 8px;
    margin-right: 0.2em;
    margin-left: 0.2em;
    background-color: rgba(#fff, 0.35);
    border-radius: 3px;
    box-shadow: 0 0 4px rgba($black, 0.1);
  }

  .entry-content__inner {
    padding-right: $space-3;
    padding-left: $space-3;
    margin-right: auto;
    margin-left: auto;

    @include tablet {
      padding-right: 0;
      padding-left: 0;
    }

    img {
      margin: $space-3 calc(100% / 12 * 1 * -1) $space-2 0;
    }

    strong {
      font-weight: 600;
      background-image: linear-gradient(
        0deg,
        rgb(255 255 0 / 30%) 45%,
        rgb(255 255 0 / 0%) 60%
      );
    }

    pre {
      padding: 1px 2rem;
      margin: $space-2 -2rem $space-2 -2rem;
      text-align: left;
      letter-spacing: normal;

      @include sizes(-1, 0);

      @include tablet {
        padding: 0 2em;
        margin-right: 0;
        margin-bottom: $space-3;
        margin-left: calc(100% / 12 * 4);

        @include sizes(0, 0);
      }
    }

    code {
      font-family: $font-mono;
    }

    a {
      transition: 0.35s $easeOutQuint;

      &:hover {
        color: $white;
        background-color: $glay;
      }
    }

    dl {
      padding: 8px;
      margin: get-line-height(-1, 0, 1) auto;
      text-align: left;
      border: 6px double currentcolor;

      @include sizes(-1, 0);

      @include tablet {
        padding: $space-2 $space-3;
        margin-top: get-line-height(0, 1, 1);
        margin-bottom: get-line-height(0, 1, 1);
        margin-left: calc(100% / 12 * 4);
      }

      code {
        @include inline-code;
      }
    }

    dt {
      margin-bottom: 0.2rem;
      font-weight: bold;
    }

    dd {
      + dt {
        margin-top: $space-2;
      }
    }

    ul,
    ol {
      padding: $space-unit $space-2 $space-unit space-scalar(4);
      margin: get-line-height(-1, 0, 1) auto;
      text-align: left;
      border: 6px double currentcolor;

      @include sizes(-1, 0);

      @include tablet {
        padding: $space-2 $space-2 $space-2 space-scalar(6);
        margin-top: get-line-height(0, 1, 1);
        margin-bottom: get-line-height(0, 1, 1);
        margin-left: calc(100% / 12 * 4);
      }

      code {
        @include inline-code;
      }
    }

    li {
      margin-left: $space-2;

      + li {
        margin-top: $space-1;
      }
    }

    ul {
      > li {
        list-style-type: square;
      }
    }

    ol {
      padding-left: $space-3;

      @include tablet {
        padding-left: space-scalar(10);
      }

      > li {
        list-style-type: decimal-leading-zero;
      }
    }

    figure {
      min-height: 200px;
      padding: 1em;
      margin-bottom: 1.5rem;
      background-color: rgba(#fff, 0.75);
    }

    p {
      margin: get-line-height(-1, 0, 1) auto;
      text-align: left;

      @include sizes(-1, 0);

      @include tablet {
        margin-top: get-line-height(0, 1, 1);
        margin-bottom: get-line-height(0, 1, 1);
        margin-left: calc(100% / 12 * 4);
        text-align: justify;

        @include sizes(0, 1);
      }

      > img {
        display: block;
        margin-top: 0;
        margin-bottom: 0;
      }

      code {
        @include inline-code;

        // 768px 以上の段落では、OS の等幅フォントが行の高さを 1px 押し広げる（旧サイトの Source Code Pro では広がらなかった）。
        // 行の高さを文字の大きさにして行に収める。背景は文字の範囲に描かれるので見た目は変わらない。
        // 767px 以下の段落と、dl・ul の中は旧サイトでも 1px 広がっていたので、そのままにする
        @include tablet {
          line-height: 1;
        }
      }
    }

    blockquote {
      padding: space-scalar(4);
      margin: get-line-height(-1, 0, 1) auto;
      font-style: italic;
      background-color: rgba($black, 0.065);
      border-left: 6px double $black;

      @include tablet {
        margin-top: get-line-height(0, 1, 1);
        margin-bottom: get-line-height(0, 1, 1);
        margin-left: calc(100% / 12 * 4);
      }

      > p {
        margin: 0;

        @include sizes(-2, 1);

        @include tablet {
          @include sizes(-1, 0);
        }
      }
    }

    h2 {
      padding-top: 0.2em;
      padding-bottom: 0.2em;
      padding-left: 0.2em;
      margin-top: get-line-height(-1, 0, 3);
      margin-bottom: get-line-height(-1, 0, 1);
      font-weight: 600;
      color: $glay;
      text-align: left;
      border-top: 6px double rgba($glay, 0.95);
      border-bottom: 6px double rgba($glay, 0.95);

      @include sizes(3, 1);

      @include tablet {
        padding-top: 0.25em;
        padding-bottom: 0.25em;
        padding-left: 0.25em;
        margin-top: get-line-height(0, 1, 3);
        margin-bottom: get-line-height(0, 1, 2);

        @include sizes(4, 1);
      }
    }

    h3 {
      padding-right: 0.2em;
      padding-bottom: 0.1em;
      padding-left: 0.2em;
      margin-top: get-line-height(-1, 0, 2);
      margin-bottom: get-line-height(-1, 0, 1);
      font-weight: 600;
      color: rgba($glay, 0.95);
      text-align: left;
      border-bottom: 6px double $glay;

      @include sizes(1, 1);

      @include tablet {
        padding-right: 0.4em;
        padding-left: 0.4em;
        margin-top: get-line-height(0, 1, 2);
        margin-bottom: get-line-height(0, 1, 1);
        margin-left: calc(100% / 12 * 4);

        @include sizes(1, 1);
      }
    }

    h4 {
      margin-top: $space-3;
      font-style: italic;
      color: $glay;
      text-align: left;
      letter-spacing: 0.1em;

      @include sizes(-1, 0);

      @include tablet {
        margin-left: calc(100% / 12 * 4);

        @include sizes(0, 0);
      }

      + pre,
      + ol,
      + ul,
      + dl {
        margin-top: $space-unit;

        @include tablet {
          margin-top: $space-1;
        }
      }
    }

    h5 {
      margin-top: 2em;
      font-size: 1.6rem;
      font-weight: 600;
      line-height: 1.5;
      color: $glay;
      text-align: left;
      letter-spacing: 0.1em;

      @include tablet {
        font-size: 1.8rem;
      }
    }
  }
</style>
