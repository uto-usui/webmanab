---
import { PUBLIC_ADSENSE_CLIENT } from 'astro:env/client'

interface Props {
  adSlot: string
}

const { adSlot } = Astro.props
---

{/* 広告のクライアント ID がないビルドでも、レイアウトを本番とそろえるため枠は出す */}
<div class="entry-ad">
  {PUBLIC_ADSENSE_CLIENT && (
    <>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client={PUBLIC_ADSENSE_CLIENT}
        data-ad-slot={adSlot}
        data-ad-format="auto"
      />
      <script is:inline>
        ;(window.adsbygoogle = window.adsbygoogle || []).push({})
      </script>
    </>
  )}
</div>

<style lang="scss" is:global>
  $ad-padding: 0.8rem;
  $ad-border: 6px;

  .entry-ad {
    // 広告が入ったときに下の要素が押し下げられないよう、AdSense が出す高さを先に取っておく。
    // 本番で測ると、幅 480px 以下は画面幅の正方形、それより広いと高さ 280px だった
    --ad-height: 280px;

    min-height: calc(var(--ad-height) + #{$ad-padding * 2} + #{$ad-border * 2});
    padding: $ad-padding;
    margin-top: $space-4;
    margin-bottom: $space-4;
    border: $ad-border double $black;

    @media screen and (width <= 480px) {
      --ad-height: 100vw;
    }
  }
</style>
