---
import {
  DEMO_PREVIEW_HEIGHT,
  DEMO_PREVIEW_WIDTH,
  demoPreview,
} from '../lib/demo-preview'
import { NEW_TAB_ID } from '../lib/new-tab.mjs'

interface Props {
  href: string
}

const { href } = Astro.props
const preview = demoPreview(href)
---

<div>
  {preview && (
    // 行き先は下の demo のリンクと同じなので、読み上げとキーボードからは外す（A11Y-02 と同じ）
    <a
      class="entry-demo__preview"
      href={href}
      target="_blank"
      rel="noopener"
      tabindex="-1"
      aria-hidden="true"
    >
      <video
        class="entry-demo__video"
        poster={preview.poster}
        width={DEMO_PREVIEW_WIDTH}
        height={DEMO_PREVIEW_HEIGHT}
        muted
        loop
        playsinline
        preload="none"
      >
        <source src={preview.video} type="video/webm" />
      </video>
    </a>
  )}
  <a
    class="entry_demo"
    href={href}
    target="_blank"
    rel="noopener"
    aria-describedby={NEW_TAB_ID}
  >
    demo
  </a>
</div>

<script>
  import '../scripts/demo-preview'
</script>

<style lang="scss">
  .entry-demo__preview {
    display: block;
    max-width: 480px;
    margin-inline: auto;
    margin-bottom: 1rem;
    border: 2px solid $black;
  }

  .entry-demo__video {
    display: block;
    width: 100%;
    height: auto;
  }
</style>

<style lang="scss" is:global>
  // 旧サイトの class 名のまま（旧サイトとの比較のキーに使う）
  // stylelint-disable-next-line selector-class-pattern
  .entry_demo {
    position: relative;
    z-index: 1;
    display: inline-block;
    margin-bottom: 3rem;
    font-size: 5rem;
    font-weight: bold;
    color: $black;
    text-transform: uppercase;
    transition: 0.45s $easeOutQuart;

    @include desktop {
      margin-bottom: -2rem;
    }

    &::after {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: -1;
      width: 60px;
      height: 60px;
      content: '';
      background: transparent;
      background-image:
        radial-gradient($black 20%, transparent 0),
        radial-gradient($black 20%, transparent 0);
      background-position:
        0 0,
        5px 5px;
      background-size: 10px 10px;
      clip-path: polygon(
        0 0,
        59% 0,
        100% 0,
        100% 50%,
        100% 99%,
        60% 100%,
        0 100%
      );
      transform: translate(-50%, -50%) rotate(45deg);
      transition: 0.45s $easeOutQuart;
    }

    &:hover {
      color: $primary-color;

      &::after {
        width: 200px;
        height: 200px;
        background: transparent;
        background-image:
          radial-gradient(rgba($black, 0.8) 20%, transparent 0),
          radial-gradient(rgba($black, 0.8) 20%, transparent 0);
        background-position:
          0 0,
          8px 8px;
        background-size: 16px 16px;
        border-radius: 50%;
        clip-path: polygon(
          0 30%,
          50% 30%,
          50% 0,
          100% 50%,
          50% 100%,
          50% 70%,
          0 70%
        );
        transform: translate(-50%, -50%) rotate(0);
      }
    }
  }
</style>
