---
import { render } from 'astro:content'
import Default from '../../layouts/Default.astro'
import Wrapper from '../../components/Wrapper.astro'
import SectionEntry from '../../components/SectionEntry.astro'
import EntryHead from '../../components/EntryHead.astro'
import EntryAd from '../../components/EntryAd.astro'
import EntryDemo from '../../components/EntryDemo.astro'
import EntryContent from '../../components/EntryContent.astro'
import EntryToc from '../../components/EntryToc.astro'
import EntryShare from '../../components/EntryShare.astro'
import EntryTag from '../../components/EntryTag.astro'
import EntryRelated from '../../components/EntryRelated.astro'
import EntryNav from '../../components/EntryNav.astro'
import EntryAdFoot from '../../components/EntryAdFoot.astro'
import {
  EYECATCH_HEIGHT,
  EYECATCH_WIDTH,
  eyecatchFor,
} from '../../lib/eyecatch'
import {
  entryPath,
  getPosts,
  neighbors,
  postStaticPaths,
  relatedPosts,
  type PostEntry,
} from '../../lib/posts'
import { pageTitle } from '../../lib/site'

export const getStaticPaths = async () =>
  postStaticPaths(await getPosts('tip'), 'tip')

interface Props {
  entry: PostEntry
}

const { entry } = Astro.props
const all = await getPosts('tip')
const { Content, headings } = await render(entry)
const { prev, next } = neighbors(all, entry)
---

<Default title={pageTitle(entry.data.title)} routeName="tip-id">
  <Wrapper>
    <SectionEntry>
      <EntryHead entry={entry} />
      <EntryAd adSlot="6597241020" />
      {entry.data.demoUrl && <EntryDemo href={entry.data.demoUrl} />}
      <EntryContent>
        <EntryToc slot="toc" headings={headings} />
        <Content />
      </EntryContent>
      {/* 装飾なので alt は空（08 の A-8） */}
      <img
        class="entry__eyecatch"
        src={eyecatchFor(entry.data).svg}
        width={EYECATCH_WIDTH}
        height={EYECATCH_HEIGHT}
        alt=""
      />
      <EntryAd adSlot="1102437429" />
      <EntryShare
        url={new URL(entryPath(entry), Astro.site).href}
        title={entry.data.title}
      />
      <EntryTag entry={entry} />
      <EntryRelated posts={relatedPosts(all, entry)} />
      <EntryNav prev={prev} next={next} />
      <EntryAdFoot />
    </SectionEntry>
  </Wrapper>
</Default>

<style lang="scss">
  // 旧サイトでは画像が壊れて 1px だった場所に、16:9 のアイキャッチを記事の幅いっぱいに出す（02 の 9.2）
  .entry__eyecatch {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
